# ──────────────────────────────────────────────
# EncryptionGuard v5 — Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
DATABASE_URL=postgresql+psycopg2://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Neo4j Aura ────────────────────────────────
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── Redis Cloud ───────────────────────────────
REDIS_URL=redis://default:password@redis-12345.c1.us-east-1-2.ec2.cloud.redislabs.com:12345

# ── Xiaomi MiMo API ──────────────────────────
MIMO_API_KEY=your-mimo-api-key
MIMO_API_BASE=https://api.mimo.xiaomi.com/v1

# ── Razorpay Test Mode ───────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── App Settings ──────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string

# ── ML Settings ───────────────────────────────
GRAPH_TTL_DAYS=90
SCORING_P95_MS=100
